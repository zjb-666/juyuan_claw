# 复制为 product/.env 后按需修改
# 警告：这些密钥只放在服务器。Windows 客户端包禁止包含本文件。

PRODUCT_HOST=0.0.0.0
PRODUCT_PORT=8787

SESSION_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=168

# 仅在未配置平台登录时作为本地演示账号
DEMO_USER=demo
DEMO_PASS=demo123
DEMO_NICKNAME=演示用户

# 产品本地库（设置/通知等卫星数据；可写）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_USER=openclaw
MYSQL_PASSWORD=openclaw_dev
MYSQL_DATABASE=openclaw_product

# ===== 平台认证 API（附属客户端正式登录；优先）=====
# LAN 直连示例：http://192.168.120.245:5000
# 公网网关示例：https://juyuancloud.com/api
PLATFORM_API_BASE_URL=http://192.168.120.245:5000
# 当前登录用户的专属 Gateway 分配接口。可填平台 API 的相对路径或独立 HTTPS URL。
# 返回 data: { gatewayUrl, gatewayRpcUrl?, gatewayToken }；gatewayToken 仅供本 BFF 使用。
# 平台校验 Authorization 中的 BFF 服务 Token，并用 X-Platform-User-Authorization 解析当前用户。
# 产品约定：一用户一台 Gateway（不是企业共享）。
# PLATFORM_DESKTOP_GATEWAY_URL=/openclaw/desktop-gateway
# PLATFORM_DESKTOP_GATEWAY_SERVICE_TOKEN=change-me-server-to-server

# 算力余额（BFF 服务端代理，禁止写入 Windows 安装包）
# 正式：平台 desktop-gateway 返回 compute_balance，或返回该用户 llm_api_key（仅 BFF）
# 联调兜底（单测用户）：BFF 用下面两项调 GET {base}/balance
# PLATFORM_GATEWAY_LLM_BASE_URL=http://192.168.120.213:5000/api/gateway
# PLATFORM_GATEWAY_LLM_API_KEY=sk-jyc-…   # 仅服务器；勿提交 git

# 平台库直连只读（仅当未配置 PLATFORM_API_BASE_URL 时的过渡回退）
# PLATFORM_MYSQL_HOST=192.168.120.245
# PLATFORM_MYSQL_PORT=3307
# PLATFORM_MYSQL_USER=root
# PLATFORM_MYSQL_PASSWORD=
# PLATFORM_MYSQL_DATABASE=textToImageAndVideo

OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_CHAT_MODEL=openclaw

# 模型（服务器侧）
MODEL_PROVIDER=openai
MODEL_ID=gpt-4.1-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 数字员工（OpenClaw 附属客户端）
OPENCLAW_PLATFORM_WEBHOOK_SECRET=change-me-shared-with-platform
# 可选：登录后拉取平台权益
# PLATFORM_ENTITLEMENTS_URL=https://juyuancloud.com/api/openclaw/entitlements
# 仅开发：无平台推送时本地授权 sku（逗号分隔）
# DIGITAL_EMPLOYEE_DEV_GRANT=hr-recruitment

# Boss 浏览器隔离（量产必须 user_node = 用户本机）
BOSS_BROWSER_MODE=user_node
BOSS_LOGIN_MODE=self
# 仅内测允许服务器浏览器时解开（生产勿开）
# BOSS_ALLOW_SERVER_BROWSER=1
# DEMO_HR_PIPELINE=1
